{
  "name": "my-memberships",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/branding.mjs",
    "predev": "npm run assets",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prebuild": "npm run assets",
    "build": "npm run check && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "bwip-js": "^4.8.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
